{
  "name": "jemput-aman-backend",
  "version": "1.0.0",
  "description": "Backend API Service for JemputAman NFC Child Pickup Verification System",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "vitest run",
    "test:supabase": "node scripts/verifySupabaseIntegration.js",
    "migrate:photo-paths": "node scripts/migrateVerificationPhotoPaths.js",
    "hash:credential": "node scripts/hashCredential.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.3"
    }
  }
