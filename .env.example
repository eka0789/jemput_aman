PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
AUTH_ALLOW_DEV_MOCK=true
APP_TIME_ZONE=Asia/Jakarta
CORS_ORIGINS=
DEFAULT_SCHOOL_ID=1001-tk-ceria-salatiga

# Backend Supabase. Gunakan secret key hanya pada server/Vercel Environment Variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Fallback development only; tetap tunduk pada RLS.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=images

# Token perangkat dari dashboard Fonnte. Jangan simpan token asli ke Git.
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=
