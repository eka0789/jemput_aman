{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JemputAman NFC Verification & Pickup API Contracts",
  "version": "1.0.0",
  "endpoints": [
    {
      "path": "/api/v1/pickup/verify-nfc",
      "method": "POST",
      "summary": "Verify NFC Card Tap at School Gate Reader",
      "requestHeader": {
        "Authorization": "Bearer <TEACHER_JWT_TOKEN>",
        "X-School-ID": "<SCHOOL_UUID>"
      },
      "requestBody": {
        "type": "object",
        "required": ["card_uid", "device_timestamp"],
        "properties": {
          "card_uid": {
            "type": "string",
            "example": "04:A2:8B:12:FE:67:80",
            "description": "Unique hardware UID read from NFC card tap"
          },
          "student_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional target student ID if selected on reader screen prior to tap"
          },
          "device_timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-23T12:00:00Z"
          }
        }
      },
      "responses": {
        "200_VERIFIED": {
          "status": "VERIFIED",
          "message": "Penjemputan Terverifikasi Sah",
          "data": {
            "pickup_log_id": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d",
            "student": {
              "id": "11111111-1111-1111-1111-111111111111",
              "full_name": "Ananda Bintang",
              "class_name": "TK-A1",
              "photo_url": "/images/students/bintang.jpg"
            },
            "pickup_person": {
              "id": "22222222-2222-2222-2222-222222222222",
              "full_name": "Budi Santoso",
              "relationship": "Ayah Kandung",
              "photo_url": "/images/pickups/budi.jpg"
            },
            "timestamp": "2026-07-23T12:00:01Z",
            "notification_sent": true
          }
        },
        "403_BLOCKED": {
          "status": "BLOCKED",
          "message": "AKSES DITOLAK: Kartu NFC Tidak Terdaftar atau Hilang",
          "alert_dispatched": true
        }
      }
    },
    {
      "path": "/api/v1/pickup/request-otp",
      "method": "POST",
      "summary": "Request Emergency OTP when Pickup Person forgot NFC Card",
      "requestBody": {
        "student_id": "11111111-1111-1111-1111-111111111111",
        "pickup_person_id": "22222222-2222-2222-2222-222222222222"
      },
      "responses": {
        "200_OK": {
          "otp_id": "55555555-5555-5555-5555-555555555555",
          "status": "PENDING_PARENT_APPROVAL",
          "expires_in_seconds": 600
        }
      }
    },
    {
      "path": "/api/v1/pickup/approve-otp",
      "method": "POST",
      "summary": "Parent approves Emergency OTP via App or inputs 6-digit code",
      "requestBody": {
        "otp_id": "55555555-5555-5555-5555-555555555555",
        "otp_code": "482910"
      },
      "responses": {
        "200_OK": {
          "status": "EMERGENCY_APPROVED",
          "message": "Verifikasi Darurat Disetujui Orang Tua"
        }
      }
    }
  ]
}
